{
  "name": "@igrp/igrp-framework-react-design-system-storybook",
  "version": "0.1.0-beta-141",
  "private": true,
  "description": "IGRP Design System Storybook",
  "type": "module",
  "author": {
    "name": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
    "email": "helpdesk@nosi.cv",
    "url": "https://igrp.cv"
  },
  "maintainers": [
    {
      "name": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
      "email": "helpdesk@nosi.cv",
      "url": "https://igrp.cv"
    }
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsc --watch",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "serve-storybook": "pnpm dlx serve storybook-static -l 6006",
    "test-storybook": "test-storybook --url http://localhost:6006 --testTimeout 60000",
    "test-storybook:ci": "test-storybook --url http://localhost:6006 --testTimeout 60000 --ci",
    "test-storybook:update-snapshots": "test-storybook --url http://localhost:6006 --testTimeout 60000 -u",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "chromatic": "chromatic --exit-zero-on-changes",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "clean-all": "rimraf node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@igrp/igrp-framework-react-design-system": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-day-picker": "9.13.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-onboarding": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@storybook/test-runner": "0.26.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "chromatic": "18.13.9",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.9",
    "storybook": "10.6.5",
    "storybook-addon-tag-badges": "3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.2"
  }
}
