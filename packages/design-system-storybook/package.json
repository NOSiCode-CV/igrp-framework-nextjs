{
  "name": "@igrp/igrp-framework-react-design-system-storybook",
  "version": "0.1.0-beta-141",
  "private": true,
  "description": "IGRP Design System Storybook",
  "type": "module",
  "author": {
    "name": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
    "email": "helpdesk@nosi.cv",
    "url": "https://igrp.cv"
  },
  "maintainers": [
    {
      "name": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
      "email": "helpdesk@nosi.cv",
      "url": "https://igrp.cv"
    }
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsc --watch",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "serve-storybook": "pnpm dlx serve storybook-static -l 6006",
    "test-storybook": "test-storybook --url http://localhost:6006",
    "test-storybook:ci": "test-storybook --url http://localhost:6006 --ci",
    "test-storybook:update-snapshots": "test-storybook --url http://localhost:6006 -u",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "chromatic": "chromatic --exit-zero-on-changes",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "clean-all": "rimraf node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@igrp/igrp-framework-react-design-system": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@storybook/test-runner": "0.24.4",
    "@types/jest": "30.0.0",
    "chromatic": "18.7.1",
    "@eslint/js": "9.39.4",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@types/node": "25.9.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.5.10",
    "storybook-addon-tag-badges": "3.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
