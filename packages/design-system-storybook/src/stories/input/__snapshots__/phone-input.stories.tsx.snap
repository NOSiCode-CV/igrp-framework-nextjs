exports[`Components/Input/Phone LimitedCountries smoke-test 1`] = `
<div class="container my-10 mx-auto p-4 border rounded-lg shadow-sm max-w-lg">
  <div role="group"
       data-slot="field"
       data-orientation="vertical"
       class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col *:w-full [&amp;&gt;.sr-only]:w-auto"
       dir="ltr"
  >
    <label data-slot="label"
