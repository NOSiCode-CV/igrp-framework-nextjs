  <div role="group"
       data-slot="field"
       data-orientation="vertical"
       class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col *:w-full [&amp;&gt;.sr-only]:w-auto"
  >
    <label data-slot="label"
           class="flex items-center text-sm leading-none font-medium select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 gap-0.5"
           for="description"
    >
      Description
    </label>
    <div class="relative">
      <textarea data-slot="textarea"
                class="flex field-sizing-content min-h-16 w-full rounded-md border px-2.5 shadow-xs transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 peer bg-background py-3 text-sm outline-hidden border-destructive focus-visible:ring-destructive/20"
                id="description"
                name="description"
                aria-required="false"
                aria-invalid="true"
                aria-describedby="description-error"
                rows="4"
                placeholder="Enter a description"
      >
