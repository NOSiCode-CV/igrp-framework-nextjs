exports[`Components/Input/Textarea WithCounter smoke-test 1`] = `
<div class="container my-10 mx-auto p-4 border rounded-lg shadow-sm">
  <div role="group"
       data-slot="field"
       data-orientation="vertical"
       class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col *:w-full [&amp;&gt;.sr-only]:w-auto"
  >
    <label data-slot="label"
           class="flex items-center text-sm leading-none font-medium select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 gap-0.5"
           for="summary"
    >
      Summary
    </label>
    <div class="relative">
      <textarea data-slot="textarea"
                class="flex field-sizing-content min-h-16 w-full rounded-md border border-input px-2.5 shadow-xs transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 peer bg-background py-3 text-sm outline-hidden"
                id="summary"
                name="summary"
                aria-required="false"
                aria-invalid="false"
                aria-describedby="summary-counter"
                maxlength="100"
                rows="3"
      >
        xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
      </textarea>
    </div>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true"
           class="h-0.5 w-full overflow-hidden rounded-full bg-border/60"
      >
        <div data-level="normal"
             class="h-full rounded-full transition-[width] bg-primary/35"
             style="width: 85%;"
        >
        </div>
      </div>
      <p id="summary-counter"
         role="status"
         aria-live="polite"
         data-level="normal"
         class="text-right text-xs tracking-tight tabular-nums text-muted-foreground"
      >
        <span class="sr-only">
          Caracteres utilizados:
        </span>
        85
        <span aria-hidden="true">
          /
        </span>
        <span class="sr-only">
          de
        </span>
        100
      </p>
    </div>
  </div>
</div>
`;

