{
  "name": "@igrp/igrp-framework-react-design-system",
  "version": "0.1.0-beta.146",
  "description": "IGRP Design System components",
  "keywords": [
    "igrp",
    "framework",
    "nextjs",
    "layout",
    "components",
    "client side"
  ],
  "author": {
    "name": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
    "email": "helpdesk@nosi.cv",
    "url": "https://igrp.cv"
  },
  "maintainers": [
    {
      "name": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
      "email": "helpdesk@nosi.cv",
      "url": "https://igrp.cv"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs.git",
    "directory": "packages/design-system"
  },
  "homepage": "https://igrp.cv",
  "bugs": {
    "url": "http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs/-/issues"
  },
  "scripts": {
    "dev": "tsc --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "pnpm build:reactcompiler",
    "build:reactcompiler": "pnpm clean:dist && pnpm build:js && pnpm build:types && pnpm check:dist",
    "build:js": "babel src --out-dir dist --extensions .ts,.tsx --source-maps --ignore \"src/**/__tests__,src/**/*.test.ts,src/**/*.test.tsx,src/**/*.d.ts\" && cpy src/*.css dist/",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/",
    "build:without_reactcompiler": "pnpm clean:dist && babel src --out-dir dist --extensions .ts,.tsx --source-maps --config-file ../../scripts/babel-config.no-react-compiler.cjs --ignore \"src/**/__tests__,src/**/*.test.ts,src/**/*.test.tsx,src/**/*.d.ts\" && cpy src/*.css dist/ && pnpm build:types && pnpm check:dist",
    "clean": "pnpm clean:dist && pnpm clean:packages",
    "clean:dist": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "clean:packages": "rimraf node_modules",
    "check:dist": "node scripts/check-dist.mjs",
    "drift:shadcn": "node scripts/check-shadcn-drift.mjs",
    "drift:shadcn:update": "node scripts/check-shadcn-drift.mjs --update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest --no-git-checks",
    "clean-all": "rimraf node_modules && rimraf dist && rimraf tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.0.0",
    "date-fns": "^4.0.0",
    "lucide-react": "^0.577.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@origin-space/image-cropper": "0.1.9",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react-day-picker": "9.11.3",
    "react-dropzone": "20.1.2",
    "react-phone-number-input": "3.4.18",
    "react-resizable-panels": "4.12.4",
    "sonner": "2.0.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "shadcn": "4.21.0",
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "10.0.1",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "cpy-cli": "7.0.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "lucide-react": "0.577.0",
    "next": "^15.5.25",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-hook-form": "7.88.0",
    "recharts": "3.10.1",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js",
      "default": "./dist/cn.js"
    },
    "./tokens": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://sonatype.nosi.cv/repository/igrp/",
    "tag": "latest",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
