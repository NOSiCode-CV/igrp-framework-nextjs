  "homepage": "https://igrp.cv",
  "bugs": {
    "url": "http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs/-/issues"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm build:reactcompiler",
    "build:babel": "rimraf dist_optimized && babel dist --out-dir dist_optimized --source-maps --extensions .ts,.js,.tsx,.jsx,.cjs,.mjs && node scripts/swap-dist.mjs && cpy src/*.css dist/",
    "build:reactcompiler": "pnpm clean:dist && pnpm build:swc && pnpm build:babel && pnpm build:types",
    "build:swc": "swc ./src -d dist --config-file .swcrc --strip-leading-paths --ignore \"**/components/experimental/**\" && cpy src/*.css dist/",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/",
    "build:without_reactcompiler": "pnpm clean:dist && pnpm build:types && pnpm build:swc",
    "clean": "pnpm clean:dist && pnpm clean:packages",
    "clean:dist": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "clean:packages": "rimraf node_modules",
    "drift:shadcn": "node scripts/check-shadcn-drift.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm format && pnpm build && pnpm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest --no-git-checks",
    "clean-all": "rimraf node_modules && rimraf dist && rimraf tsconfig.tsbuildinfo"
  },
