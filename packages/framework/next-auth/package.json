{
  "name": "@igrp/framework-next-auth",
  "version": "0.2.0-beta.11",
  "description": "IGRP Framework for Next.js | Auth",
  "author": "IGRP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs.git",
    "directory": "packages/framework/next-auth"
  },
  "homepage": "https://igrp.cv",
  "bugs": {
    "url": "http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs/-/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.2"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "default": "./dist/session.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "import": "./dist/jwt.js",
      "default": "./dist/jwt.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "import": "./dist/oidc.js",
      "default": "./dist/oidc.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "default": "./dist/providers.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "import": "./dist/sanitize.js",
      "default": "./dist/sanitize.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./claims": {
      "types": "./dist/claims.d.ts",
      "import": "./dist/claims.js",
      "default": "./dist/claims.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "import": "./dist/cookies.js",
      "default": "./dist/cookies.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./session-store": {
      "types": "./dist/session-store.d.ts",
      "import": "./dist/session-store.js",
      "default": "./dist/session-store.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "format": "prettier --write . --ignore-path ../../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../../.prettierignore",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "build:js": "tsdown",
    "build": "pnpm clean && pnpm build:js",
    "clean-all": "rimraf node_modules && rimraf dist && rimraf tsconfig.tsbuildinfo",
    "release": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest --no-git-checks",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "next": "^15.5.0",
    "next-auth": "^4.24.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://sonatype.nosi.cv/repository/igrp/",
    "tag": "latest"
  },
  "keywords": [
    "igrp",
    "framework",
    "nextjs",
    "auth"
  ]
}
