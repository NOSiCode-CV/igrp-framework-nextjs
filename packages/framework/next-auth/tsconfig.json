{
  // Type-check / editor config ONLY — this project does not emit.
  //
  // It used to carry `composite: true`, `noEmit: false` and `outDir: ./dist`
  // on a package whose `dist/` is produced entirely by tsup. Any bare `tsc`
  // or `tsc -b` in this directory therefore wrote a second, competing build
  // over the tsup output. Nothing ran it, so nothing caught it.
  //
  // Emission lives in `tsconfig.build.json`, which is composite and
  // declaration-only. Note that a TypeScript project reference may not point
  // at a project with `noEmit` (TS6310), so this file can never be a
  // reference target — `tsconfig.build.json` is the one to reference if the
  // package ever moves its `.d.ts` emit off tsup.
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",

    "strict": true,
    // Unused imports/locals are errors here because this package has no
    // ESLint config: `pnpm lint` is `pnpm -r run lint`, which silently skips
    // any package without the script, so `tsc` is the only gate there is.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "composite": false,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
