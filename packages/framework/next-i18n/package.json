{
  "name": "@igrp/framework-next-i18n",
  "version": "0.2.0-beta.5",
  "description": "Catalog and literal-string checks for IGRP Next.js apps (igrp-i18n CLI)",
  "author": "IGRP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs.git",
    "directory": "packages/framework/next-i18n"
  },
  "type": "module",
  "bin": {
    "igrp-i18n": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "tsdown",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "rimraf dist && pnpm build:js && pnpm build:types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "format": "prettier --write . --ignore-path ../../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../../.prettierignore",
    "release": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest --no-git-checks",
    "clean": "rimraf dist",
    "clean-all": "rimraf node_modules && rimraf dist"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "publishConfig": {
    "registry": "https://sonatype.nosi.cv/repository/igrp/",
    "tag": "latest",
    "access": "public"
  }
}
