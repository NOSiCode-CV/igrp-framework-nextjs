{
  "name": "@igrp/framework-next-types",
  "version": "0.1.0-beta.149",
  "type": "module",
  "description": "IGRP Framework for Next.js | Types",
  "keywords": [
    "igrp",
    "framework",
    "nextjs",
    "types"
  ],
  "author": "IGRP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs.git",
    "directory": "packages/framework/next-types"
  },
  "homepage": "https://igrp.cv",
  "bugs": {
    "url": "http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs/-/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "rimraf dist tsconfig.tsbuildinfo && pnpm format && pnpm check:barrel && pnpm check:contract && tsc -b && pnpm check:dist",
    "format": "prettier --write .",
    "release": "pnpm build && pnpm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest --no-git-checks",
    "clean-all": "rimraf node_modules && rimraf dist && rimraf tsconfig.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.contract.json",
    "check:contract": "tsc -p tsconfig.contract.json",
    "check:barrel": "node scripts/check-barrel.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "peerDependencies": {
    "next-auth": "^4.24.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@igrp/framework-next-auth": "workspace:*"
  },
  "devDependencies": {
    "@igrp/platform-access-management-client-ts": "^0.2.0-beta.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "next-auth": "4.24.15",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "rimraf": "6.1.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://sonatype.nosi.cv/repository/igrp/",
    "tag": "latest",
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
