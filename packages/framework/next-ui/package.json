{
  "name": "@igrp/framework-next-ui",
  "version": "0.2.0-beta.0",
  "description": "IGRP Framework for Next.js | Design System components",
  "keywords": [
    "igrp",
    "framework",
    "nextjs",
    "layout",
    "components",
    "client side"
  ],
  "author": "IGRP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs.git",
    "directory": "packages/framework/next-ui"
  },
  "homepage": "https://igrp.cv",
  "bugs": {
    "url": "http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs/-/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "pnpm build:reactcompiler",
    "build:reactcompiler": "pnpm clean:dist && pnpm build:js && pnpm build:types && pnpm check:dist",
    "build:js": "babel src --out-dir dist --extensions .ts,.tsx --source-maps --ignore \"src/**/__tests__,src/**/*.test.ts,src/**/*.test.tsx,src/**/*.d.ts\" && cpy src/*.css dist/",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/",
    "build:without_reactcompiler": "pnpm clean:dist && babel src --out-dir dist --extensions .ts,.tsx --source-maps --config-file ../../../scripts/babel-config.no-react-compiler.cjs --ignore \"src/**/__tests__,src/**/*.test.ts,src/**/*.test.tsx,src/**/*.d.ts\" && cpy src/*.css dist/ && pnpm build:types && pnpm check:dist",
    "clean": "pnpm clean:dist && pnpm clean:packages",
    "check:dist": "node scripts/check-dist.mjs",
    "clean:dist": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "clean:packages": "rimraf node_modules",
    "format": "prettier --write .",
    "release": "pnpm format && pnpm build && pnpm typecheck && pnpm test && pnpm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest --no-git-checks",
    "clean-all": "rimraf node_modules && rimraf dist && rimraf tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "next": "^15.5.0",
    "next-auth": "^4.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@igrp/framework-next-auth": "workspace:*",
    "@igrp/framework-next-types": "workspace:*",
    "@igrp/igrp-framework-react-design-system": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "cpy-cli": "7.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jsdom": "30.1.1",
    "next": "15.5.25",
    "next-auth": "^4.24.15",
    "postcss": "8.5.28",
    "prettier": "^3.9.9",
    "react": "19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.1"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://sonatype.nosi.cv/repository/igrp/",
    "tag": "latest",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
