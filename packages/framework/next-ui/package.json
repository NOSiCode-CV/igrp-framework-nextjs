{
  "name": "@igrp/framework-next-ui",
  "version": "0.2.0-beta.23",
  "description": "IGRP Framework for Next.js | Design System components",
  "keywords": [
    "igrp",
    "framework",
    "nextjs",
    "layout",
    "components",
    "client side"
  ],
  "author": "IGRP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs.git",
    "directory": "packages/framework/next-ui"
  },
  "homepage": "https://igrp.cv",
  "bugs": {
    "url": "http://git.nosi.cv/igrp-3_0/igrp-framework-frontend/igrp-framework-nextjs/-/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "build": "pnpm build:reactcompiler",
    "build:reactcompiler": "pnpm clean:dist && pnpm build:js && pnpm build:types && pnpm check:dist",
    "build:js": "babel src --out-dir dist --extensions .ts,.tsx --source-maps --ignore \"src/**/__tests__,src/**/*.test.ts,src/**/*.test.tsx,src/**/*.d.ts\" && cpy src/*.css dist/ --flat",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/",
    "build:without_reactcompiler": "pnpm clean:dist && babel src --out-dir dist --extensions .ts,.tsx --source-maps --config-file ../../../scripts/babel-config.no-react-compiler.cjs --ignore \"src/**/__tests__,src/**/*.test.ts,src/**/*.test.tsx,src/**/*.d.ts\" && cpy src/*.css dist/ --flat && pnpm build:types && pnpm check:dist",
    "clean": "pnpm clean:dist && pnpm clean:packages",
    "check:dist": "node ../../../scripts/check-dist.mjs",
    "clean:dist": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "clean:packages": "rimraf node_modules",
    "format": "prettier --write . --ignore-path ../../../.prettierignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path ../../../.prettierignore --ignore-path .prettierignore",
    "release": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest --no-git-checks",
    "clean-all": "rimraf node_modules && rimraf dist && rimraf tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "lucide-react": "^0.577.0 || ^1.0.0",
    "next": "^15.5.0",
    "next-auth": "^4.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@igrp/framework-next-auth": "workspace:*",
    "@igrp/framework-next-types": "workspace:*",
    "@igrp/igrp-framework-react-design-system": "workspace:*",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cpy-cli": "7.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "lucide-react": "1.79.0",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://sonatype.nosi.cv/repository/igrp/",
    "tag": "latest",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.22.2"
  }
}
