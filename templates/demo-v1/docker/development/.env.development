# Development image: runs the template with no IdP / Access Management backend.
# `isAuthBypass()` (preview mode OR AUTH_PROVIDER=none) short-circuits every
# auth-aware path, so no NEXTAUTH_* / IGRP_AUTH_* values are needed here.
AUTH_PROVIDER=none
IGRP_PREVIEW_MODE=true
IGRP_SYNC_ACCESS=false
# This image is a production build that runs in preview mode on purpose.
IGRP_ALLOW_AUTH_BYPASS_IN_PRODUCTION=true

NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ALLOWED_DOMAINS=

# --- Running against IGRP Access Management ---------------------------------
# Do NOT put these here: this file is copied into the image at build time, and
# Next copies it into the runtime image, so anything here ships in every layer.
# Pass them at run time instead (`docker run --env-file`, Compose `env_file`),
# and override ALL of the bypass defaults above in that same file, or the app
# keeps running without login:
#   AUTH_PROVIDER=igrp-auth
#   IGRP_PREVIEW_MODE=false
#   IGRP_ALLOW_AUTH_BYPASS_IN_PRODUCTION=false
#   IGRP_AUTH_CLIENT_ID, IGRP_AUTH_CLIENT_SECRET, IGRP_AUTH_ISSUER,
#   IGRP_AUTH_SCOPES, NEXTAUTH_URL (<public origin><basePath>/api/auth),
#   NEXTAUTH_SECRET, IGRP_ACCESS_MANAGEMENT_API, IGRP_APP_CODE
# Only NEXT_PUBLIC_* values must be set here (before building), e.g.
# NEXT_PUBLIC_IGRP_APP_CODE=DEMO_APP. See docs/DOCKER-RUN.md ("Environment").
