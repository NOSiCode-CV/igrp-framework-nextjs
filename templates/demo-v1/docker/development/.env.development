# Development image: runs the template with no IdP / Access Management backend.
# `isAuthBypass()` (preview mode OR AUTH_PROVIDER=none) short-circuits every
# auth-aware path, so no NEXTAUTH_* / IGRP_AUTH_* values are needed here.
AUTH_PROVIDER=none
IGRP_PREVIEW_MODE=true
IGRP_SYNC_ACCESS=false
# This image is a production build that runs in preview mode on purpose.
IGRP_ALLOW_AUTH_BYPASS_IN_PRODUCTION=true

NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ALLOWED_DOMAINS=

# --- Minimum to run against IGRP Access Management ---------------------------
# Delete the four bypass lines above (AUTH_PROVIDER, IGRP_PREVIEW_MODE,
# IGRP_SYNC_ACCESS, IGRP_ALLOW_AUTH_BYPASS_IN_PRODUCTION), uncomment these and
# fill them in. This file is baked into the image at build time, so rebuild
# after editing; keep real secrets out of git. See docs/ENVIRONMENT.md
# ("Minimum for Access Management").
# AUTH_PROVIDER=igrp-auth
# IGRP_PREVIEW_MODE=false
# IGRP_AUTH_CLIENT_ID=igrp-access-management
# IGRP_AUTH_CLIENT_SECRET=
# IGRP_AUTH_ISSUER=
# IGRP_AUTH_SCOPES=openid
# Compose publishes the container on host port 3001; <basePath>/api/auth.
# NEXTAUTH_URL=http://localhost:3001/api/auth
# NEXTAUTH_SECRET=
# IGRP_ACCESS_MANAGEMENT_API=
# IGRP_APP_CODE=DEMO_APP
# NEXT_PUBLIC_IGRP_APP_CODE=DEMO_APP
