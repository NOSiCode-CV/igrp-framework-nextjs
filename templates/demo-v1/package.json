{
  "name": "@igrp/framework-next-template",
  "version": "0.2.0-beta.7",
  "private": true,
  "description": "igrp template",
  "displayName": "igrp template",
  "keywords": [
    "igrp",
    "framework",
    "nextjs",
    "template"
  ],
  "author": "IGRP Team",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm lint && pnpm lint:i18n && next build --turbopack",
    "start": "next start",
    "lint": "biome check --write",
    "lint:i18n": "igrp-i18n check-catalogs src/i18n/messages --default pt && igrp-i18n check-literals src/components src/i18n \"src/app/(igrp)/page.tsx\" src/config \"src/app/(auth)\" src/app/not-found.tsx src/app/layout.tsx src/app/global-error.tsx src/app/error.tsx \"src/app/(igrp)/error.tsx\" \"src/app/(igrp)/layout.tsx\"",
    "format": "biome format --write",
    "publish:template": "pwsh -ExecutionPolicy Bypass -File ./create-template/create-zip-template.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@igrp/framework-next": "workspace:*",
    "@igrp/framework-next-auth": "workspace:*",
    "@igrp/framework-next-ui": "workspace:*",
    "@igrp/igrp-framework-react-design-system": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "redis": "5.12.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@igrp/framework-next-types": "workspace:*",
    "@igrp/framework-next-i18n": "workspace:*",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
