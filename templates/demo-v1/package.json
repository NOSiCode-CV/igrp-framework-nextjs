{
  "name": "@igrp/framework-next-template",
  "version": "0.1.0-beta.121",
  "private": true,
  "description": "igrp template",
  "displayName": "igrp template",
  "keywords": [
    "igrp",
    "framework",
    "nextjs",
    "template"
  ],
  "author": "IGRP Team",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
